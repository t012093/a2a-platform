generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  CLIENT
  AGENT
  PLATFORM
}

enum UserRole {
  CLIENT_ADMIN
  CLIENT_APPROVER
  AGENT_ADMIN
  AGENT_APPROVER
  PLATFORM_ADMIN
}

enum RfpStatus {
  DRAFT
  SUBMITTED
  CLOSED
  CANCELLED
}

enum OfferStatus {
  PROPOSED
  REVISED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ContractStatus {
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  TERMINATED
  EXPIRED
}

enum PaymentStatus {
  ESCROW_PENDING
  ESCROWED
  RELEASE_PENDING
  RELEASED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  ADYEN
  OTHER
}

enum ApprovalStatus {
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeDecision {
  FULL_RELEASE
  PARTIAL_RELEASE
  FULL_REFUND
}

enum NegotiationStatus {
  ACTIVE
  INPUT_REQUIRED
  COMPLETED
  REJECTED
  CANCELLED
  TIMEOUT
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  orgType   OrgType
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  agents    Agent[]
  rfps      Rfp[]
  settings  NotificationSetting?
}

model User {
  id        String   @id @default(uuid())
  orgId     String
  email     String   @unique
  role      UserRole
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id])
  notifications UserNotificationSetting?
  refreshTokens RefreshToken[]
}

model Agent {
  id                 String   @id @default(uuid())
  orgId              String
  name               String
  providerOrg        String
  agentCardJson      Json
  skills             Json
  defaultInputModes  String[]
  defaultOutputModes String[]
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org                Organization @relation(fields: [orgId], references: [id])
  offers             Offer[]
  negotiations       Negotiation[]
  paymentAccounts    PaymentAccount[]
}

model Rfp {
  id              String    @id @default(uuid())
  clientOrgId     String
  title           String
  requirementsJson Json
  status          RfpStatus @default(DRAFT)
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clientOrg Organization @relation(fields: [clientOrgId], references: [id])
  offers    Offer[]
  negotiations Negotiation[]
  contracts Contract[]
}

model Offer {
  id        String     @id @default(uuid())
  rfpId     String
  agentId   String
  offerJson Json
  status    OfferStatus @default(PROPOSED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  rfp   Rfp   @relation(fields: [rfpId], references: [id])
  agent Agent @relation(fields: [agentId], references: [id])
  contracts Contract[]
}

model Negotiation {
  id          String   @id @default(uuid())
  rfpId       String
  agentId     String
  a2aTaskId   String
  a2aContextId String
  status      NegotiationStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rfp   Rfp   @relation(fields: [rfpId], references: [id])
  agent Agent @relation(fields: [agentId], references: [id])
}

model Contract {
  id            String         @id @default(uuid())
  rfpId         String
  offerId       String
  termsJson     Json
  status        ContractStatus @default(PENDING_APPROVAL)
  signedAt      DateTime?
  disputeStatus String         @default("none")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  rfp    Rfp   @relation(fields: [rfpId], references: [id])
  offer  Offer @relation(fields: [offerId], references: [id])
  payments Payment[]
  disputes Dispute[]
}

model Approval {
  id         String   @id @default(uuid())
  targetType String
  targetId   String
  actorId    String
  actorRole  UserRole
  status     ApprovalStatus
  reason     String?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
}

model Payment {
  id                     String        @id @default(uuid())
  contractId             String
  amount                 Int
  currency               String
  status                 PaymentStatus @default(ESCROW_PENDING)
  provider               PaymentProvider
  providerPaymentIntentId String?
  providerTransferId     String?
  providerRef            String?
  platformFeeRate        Float?
  platformFeeAmount      Int?
  netAmount              Int?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
  events   PaymentEvent[]
}

model PaymentAccount {
  id         String         @id @default(uuid())
  agentId    String
  provider   PaymentProvider
  accountId  String
  status     String         @default("pending")
  detailsJson Json
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  agent Agent @relation(fields: [agentId], references: [id])
}

model NotificationSetting {
  id                String   @id @default(uuid())
  orgId             String   @unique
  timezone          String   @default("UTC")
  businessHoursStart String
  businessHoursEnd  String
  sendOnWeekend     Boolean  @default(false)
  channels          String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id])
}

model UserNotificationSetting {
  id                String   @id @default(uuid())
  userId            String   @unique
  timezone          String   @default("UTC")
  businessHoursStart String
  businessHoursEnd  String
  sendOnWeekend     Boolean  @default(false)
  channels          String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  eventType String
  payloadJson Json
  createdAt DateTime @default(now())
}

model PaymentEvent {
  id         String   @id @default(uuid())
  paymentId  String
  eventType  String
  payloadJson Json
  createdAt  DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

model Dispute {
  id            String         @id @default(uuid())
  contractId    String
  status        DisputeStatus  @default(OPEN)
  openedBy      String
  reason        String?
  evidenceRefs  Json
  decision      DisputeDecision?
  decisionAmount Int?
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
